{
  "version": 2,
  "rewrites": [
    { "source": "/business-index.json", "destination": "/api/business-index" },
    { "source": "/business/(.*)", "destination": "/api/business" },
    { "source": "/valuation-client.js", "destination": "/api/valuation-assets" },
    { "source": "/valuation-history-client.js", "destination": "/api/valuation-history-client" },
    { "source": "/valuation-history-actions.js", "destination": "/api/valuation-history-client?asset=actions" },
    { "source": "/estimate", "destination": "/api/valuation-router?route=estimate" },
    { "source": "/valuation", "destination": "/api/valuation-router?route=home" },
    { "source": "/valuation/new", "destination": "/api/valuation-router?route=new" },
    { "source": "/valuation/history", "destination": "/api/valuation-history" },
    { "source": "/valuation/report", "destination": "/api/valuation-router?route=report" },
    { "source": "/valuation/result/:id", "destination": "/api/valuation-router?route=result&id=:id" },
    { "source": "/(.*)", "destination": "/api/app2" }
  ]
}
