rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function chairman() {
      return signed() &&
        exists(/databases/$(database)/documents/roles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.chairman == true;
    }
    function validFlat(n) { return n is int && n >= 1 && n <= 60; }
    function validEntrance(n) { return n is int && n >= 1 && n <= 3; }
    function validFloor(n) { return n is int && n >= 2 && n <= 8; }
    function validName(n) { return n is string && n.size() >= 2 && n.size() <= 70; }
    function validPhone(n) {
      return n is string && n.matches('^[+]?[0-9 ()-]{7,25}$');
    }
    function validApplication(d,uid) {
      return d.keys().hasOnly(['uid','apartment','entrance','floor','relation','status','createdAt']) &&
        d.keys().hasAll(['uid','apartment','entrance','floor','relation','status','createdAt']) &&
        d.uid == uid && d.status == 'pending' &&
        validFlat(d.apartment) && validEntrance(d.entrance) && validFloor(d.floor) &&
        d.relation in ['owner','resident'] &&
        d.createdAt == request.time;
    }
    match /roles/{uid} {
      allow get: if signed() && request.auth.uid == uid;
      allow list,create,update,delete: if false;
    }
    match /profiles/{uid} {
      allow get: if signed() &&
        (request.auth.uid == uid ||
          (chairman() && (
            exists(/databases/$(database)/documents/applications/$(uid)) ||
            exists(/databases/$(database)/documents/members/$(uid))
          )));
      allow create: if signed() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['first','last','phone','createdAt']) &&
        request.resource.data.keys().hasAll(['first','last','phone','createdAt']) &&
        validName(request.resource.data.first) &&
        validName(request.resource.data.last) &&
        validPhone(request.resource.data.phone) &&
        request.resource.data.createdAt == request.time;
      allow list,update,delete: if false;
    }
    match /units/{unitId} {
      allow read: if signed();
      allow create,update: if chairman() &&
        request.resource.data.keys().hasOnly(['apartment','entrance','floor']) &&
        request.resource.data.keys().hasAll(['apartment','entrance','floor']) &&
        validFlat(request.resource.data.apartment) &&
        string(request.resource.data.apartment) == unitId &&
        validEntrance(request.resource.data.entrance) &&
        validFloor(request.resource.data.floor);
      allow delete: if false;
    }
    match /applications/{uid} {
      allow get: if signed() && (request.auth.uid == uid || chairman());
      allow list: if chairman();
      allow create: if signed() && request.auth.uid == uid &&
        request.auth.token.email_verified == true &&
        !exists(/databases/$(database)/documents/members/$(uid)) &&
        validApplication(request.resource.data,uid);
      allow update: if signed() &&
        (
          (chairman() && resource.data.status == 'pending' &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status','reviewedBy','reviewedAt']) &&
            request.resource.data.status in ['approved','rejected'] &&
            request.resource.data.reviewedBy == request.auth.uid &&
            request.resource.data.reviewedAt == request.time)
          ||
          (request.auth.uid == uid &&
            request.auth.token.email_verified == true &&
            resource.data.status in ['rejected','approved'] &&
            !exists(/databases/$(database)/documents/members/$(uid)) &&
            validApplication(request.resource.data,uid))
        );
      allow delete: if false;
    }
    match /members/{uid} {
      allow get: if signed() && (request.auth.uid == uid || chairman());
      allow list: if chairman();
      allow create: if chairman() &&
        request.resource.data.keys().hasOnly(['uid','apartment','entrance','floor','relation','approvedAt']) &&
        request.resource.data.keys().hasAll(['uid','apartment','entrance','floor','relation','approvedAt']) &&
        request.resource.data.uid == uid &&
        validFlat(request.resource.data.apartment) &&
        validEntrance(request.resource.data.entrance) &&
        validFloor(request.resource.data.floor) &&
        request.resource.data.relation in ['owner','resident'] &&
        request.resource.data.approvedAt == request.time &&
        getAfter(/databases/$(database)/documents/applications/$(uid)).data.status == 'approved' &&
        getAfter(/databases/$(database)/documents/applications/$(uid)).data.apartment ==
          request.resource.data.apartment &&
        getAfter(/databases/$(database)/documents/units/$(string(request.resource.data.apartment))).data.entrance ==
          request.resource.data.entrance &&
        getAfter(/databases/$(database)/documents/units/$(string(request.resource.data.apartment))).data.floor ==
          request.resource.data.floor;
      allow update,delete: if false;
    }

    // Apartment announcements are available only to an approved resident or chairman.
    match /announcements/{announcementId} {
      allow get, list: if signed() &&
        (chairman() || exists(/databases/$(database)/documents/members/$(request.auth.uid)));
      allow create: if chairman() &&
        request.resource.data.keys().hasAll(['title','body','authorUid','createdAt']) &&
        request.resource.data.keys().hasOnly(['title','body','authorUid','createdAt']) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() >= 3 &&
        request.resource.data.title.size() <= 130 &&
        request.resource.data.body is string &&
        request.resource.data.body.size() >= 3 &&
        request.resource.data.body.size() <= 2500 &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // A verified, approved resident can file a repair request for THEIR apartment.
    // The chairman can see all requests and only update progress fields.
    match /repairs/{repairId} {
      allow get, list: if signed() &&
        (chairman() || resource.data.authorUid == request.auth.uid);
      allow create: if signed() &&
        request.auth.token.email_verified == true &&
        exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
        request.resource.data.keys().hasAll([
          'authorUid','apartment','title','details','status','createdAt','updatedAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'authorUid','apartment','title','details','status','createdAt','updatedAt'
        ]) &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.apartment ==
          get(/databases/$(database)/documents/members/$(request.auth.uid)).data.apartment &&
        validFlat(request.resource.data.apartment) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() >= 4 &&
        request.resource.data.title.size() <= 140 &&
        request.resource.data.details is string &&
        request.resource.data.details.size() >= 4 &&
        request.resource.data.details.size() <= 1500 &&
        request.resource.data.status == 'open' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if chairman() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status','updatedAt']) &&
        request.resource.data.status in ['open','progress','done'] &&
        request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Monthly uniform charge in GEL tetri, for all 60 apartments.
    // Immutable after creation: historical fees cannot silently be rewritten.
    match /months/{month} {
      allow get, list: if signed() &&
        (chairman() || exists(/databases/$(database)/documents/members/$(request.auth.uid)));
      allow create: if chairman() &&
        month.matches('^20[0-9]{2}-(0[1-9]|1[0-2])
  }
}) &&
        request.resource.data.keys().hasAll(['month','amountTetri','createdAt','createdBy']) &&
        request.resource.data.keys().hasOnly(['month','amountTetri','createdAt','createdBy']) &&
        request.resource.data.month == month &&
        request.resource.data.amountTetri is int &&
        request.resource.data.amountTetri >= 0 &&
        request.resource.data.amountTetri <= 10000000 &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Audit-friendly append-only cash receipts. No payment processing or bank connection.
    // Ordinary residents must query only their approved apartment, never a full collection.
    match /payments/{paymentId} {
      allow get, list: if signed() &&
        (chairman() ||
          (exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
          resource.data.apartment ==
            get(/databases/$(database)/documents/members/$(request.auth.uid)).data.apartment));
      allow create: if chairman() &&
        request.resource.data.keys().hasAll([
          'apartment','month','amountTetri','note','createdBy','createdAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'apartment','month','amountTetri','note','createdBy','createdAt'
        ]) &&
        validFlat(request.resource.data.apartment) &&
        request.resource.data.month is string &&
        request.resource.data.month.matches('^20[0-9]{2}-(0[1-9]|1[0-2])
  }
}) &&
        request.resource.data.amountTetri is int &&
        request.resource.data.amountTetri > 0 &&
        request.resource.data.amountTetri <= 100000000 &&
        request.resource.data.note is string &&
        request.resource.data.note.size() <= 250 &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /{document=**} { allow read,write: if false; }
  }
}